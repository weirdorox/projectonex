<Project>
  <!--
    Central package versions. If `dotnet restore` reports that a version cannot be found,
    bump it to the newest stable version shown on nuget.org - the APIs used are stable.
  -->
  <ItemGroup>
    <!-- UI -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.8.250916003" />

    <!-- Data -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.0" />

    <!-- Windows platform -->
    <PackageVersion Include="System.Management" Version="10.0.0" />
    <PackageVersion Include="System.Diagnostics.PerformanceCounter" Version="10.0.0" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>
</Project>
