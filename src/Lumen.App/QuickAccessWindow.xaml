<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lumen.App.QuickAccessWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lumen Quick Access">

    <Grid Background="{StaticResource LumenSurfaceBrush}" BorderBrush="{StaticResource LumenStrokeBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
            <StackPanel Padding="24,28,24,28" Spacing="20">

                <!-- Header -->
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="ClockText" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource LumenTextBrush}" />
                        <TextBlock x:Name="BatteryText" Style="{StaticResource LumenCaptionText}" FontSize="15" />
                    </StackPanel>
                    <Ellipse Width="12" Height="12" Fill="{StaticResource LumenAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" />
                </Grid>

                <!-- Navigation -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="HomeButton" HorizontalAlignment="Stretch" Style="{StaticResource LumenAccentButtonStyle}" Click="OnHomeClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE80F;" FontSize="16" />
                            <TextBlock Text="Lumen" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="OnDesktopClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                            <TextBlock Text="Desktop" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Section tabs (LB / RB) -->
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="LB" FontSize="11" FontWeight="Bold" Foreground="{StaticResource LumenTextDimBrush}" VerticalAlignment="Center" />
                    <Button x:Name="QuickTab" Grid.Column="1" Content="Quick" Tag="0" Click="OnSectionClick" Style="{StaticResource LumenPillButtonStyle}" Padding="4,6" FontSize="13" HorizontalAlignment="Stretch" />
                    <Button x:Name="PowerTab" Grid.Column="2" Content="Power" Tag="1" Click="OnSectionClick" Style="{StaticResource LumenPillButtonStyle}" Padding="4,6" FontSize="13" HorizontalAlignment="Stretch" />
                    <Button x:Name="BatteryTab" Grid.Column="3" Content="Battery" Tag="2" Click="OnSectionClick" Style="{StaticResource LumenPillButtonStyle}" Padding="4,6" FontSize="13" HorizontalAlignment="Stretch" />
                    <Button x:Name="GameTab" Grid.Column="4" Content="Game" Tag="3" Click="OnSectionClick" Style="{StaticResource LumenPillButtonStyle}" Padding="4,6" FontSize="13" HorizontalAlignment="Stretch" />
                    <Button x:Name="SystemTab" Grid.Column="5" Content="System" Tag="4" Click="OnSectionClick" Style="{StaticResource LumenPillButtonStyle}" Padding="4,6" FontSize="13" HorizontalAlignment="Stretch" />
                    <TextBlock Grid.Column="6" Text="RB" FontSize="11" FontWeight="Bold" Foreground="{StaticResource LumenTextDimBrush}" VerticalAlignment="Center" />
                </Grid>

                <!-- ================= QUICK ================= -->
                <StackPanel x:Name="QuickPanel" Spacing="20">

                <!-- Volume -->
                <StackPanel x:Name="VolumeSection" Spacing="4">
                    <Grid>
                        <TextBlock Text="Volume" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" />
                        <TextBlock x:Name="VolumeValue" Style="{StaticResource LumenCaptionText}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" StepFrequency="5" ValueChanged="OnVolumeChanged"
                                AutomationProperties.Name="Volume" />
                        <Button x:Name="MuteButton" Grid.Column="1" Click="OnMuteClick" AutomationProperties.Name="Mute">
                            <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="16" />
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Brightness -->
                <StackPanel x:Name="BrightnessSection" Spacing="4">
                    <Grid>
                        <TextBlock Text="Brightness" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" />
                        <TextBlock x:Name="BrightnessValue" Style="{StaticResource LumenCaptionText}" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="BrightnessSlider" Minimum="5" Maximum="100" StepFrequency="5" ValueChanged="OnBrightnessChanged"
                            AutomationProperties.Name="Brightness" />
                </StackPanel>

                <!-- Refresh rate -->
                <StackPanel x:Name="RefreshSection" Spacing="8">
                    <TextBlock Text="Refresh rate" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" />
                    <VariableSizedWrapGrid x:Name="RefreshPanel" Orientation="Horizontal" ItemWidth="112" ItemHeight="56" />
                </StackPanel>

                <!-- Performance overlay -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Performance overlay" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" />
                    <VariableSizedWrapGrid x:Name="OverlayPanel" Orientation="Horizontal" ItemWidth="136" ItemHeight="56" />
                    <TextBlock x:Name="OverlayNote" Style="{StaticResource LumenCaptionText}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Resolution (driver-tested; asks to keep, reverts automatically) -->
                <StackPanel x:Name="ResolutionSection" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="Resolution" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" />
                    <VariableSizedWrapGrid x:Name="ResolutionPanel" Orientation="Horizontal" ItemWidth="136" ItemHeight="56" />
                    <StackPanel x:Name="ResolutionConfirm" Spacing="8" Visibility="Collapsed">
                        <TextBlock x:Name="ResolutionConfirmText" Style="{StaticResource LumenCaptionText}" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ResolutionKeepButton" Content="Keep" HorizontalAlignment="Stretch" Click="OnResolutionKeepClick" Style="{StaticResource LumenAccentButtonStyle}" />
                            <Button Grid.Column="1" Content="Revert" HorizontalAlignment="Stretch" Click="OnResolutionRevertClick" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- HDR / display state -->
                <StackPanel x:Name="HdrSection" Spacing="4" Visibility="Collapsed">
                    <ToggleSwitch x:Name="HdrToggle" Header="HDR" Toggled="OnHdrToggled" />
                    <TextBlock x:Name="HdrNote" Style="{StaticResource LumenCaptionText}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="DockText" Style="{StaticResource LumenCaptionText}" />

                <!-- Audio -->
                <ToggleSwitch x:Name="MicToggle" Header="Microphone muted" Toggled="OnMicToggled" Visibility="Collapsed" />
                <StackPanel x:Name="OutputSection" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="Audio output" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" />
                    <StackPanel x:Name="OutputPanel" Spacing="8" />
                </StackPanel>

                <!-- Power plan -->
                <StackPanel x:Name="PowerSection" Spacing="8">
                    <TextBlock Text="Power plan" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" />
                    <StackPanel x:Name="PlansPanel" Spacing="8" />
                    <Button Content="Windows power settings" Click="OnPowerSettingsClick" HorizontalAlignment="Stretch" />
                </StackPanel>



                <TextBlock x:Name="UnsupportedText" Style="{StaticResource LumenCaptionText}" FontSize="13" />
                </StackPanel>

                <!-- ================= POWER ================= -->
                <StackPanel x:Name="PowerPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Smart Power" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" />
                    <Slider x:Name="SmartSlider" Minimum="0" Maximum="100" StepFrequency="5" ValueChanged="OnSmartChanged"
                            AutomationProperties.Name="Smart Power: battery life to performance" />
                    <Grid>
                        <TextBlock Text="Battery life" Style="{StaticResource LumenCaptionText}" FontSize="12" />
                        <TextBlock Text="Performance" Style="{StaticResource LumenCaptionText}" FontSize="12" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock x:Name="SmartPreviewText" Style="{StaticResource LumenCaptionText}" />
                    <Button x:Name="SmartApplyButton" Content="Apply Smart Power" HorizontalAlignment="Stretch" Click="OnSmartApplyClick" />
                    <ToggleSwitch x:Name="SmartAutoToggle" Header="Switch automatically between battery and AC" Toggled="OnSmartAutoToggled" />

                    <TextBlock Text="Processor power (TDP)" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock x:Name="TdpStatusText" Style="{StaticResource LumenCaptionText}" />
                    <StackPanel x:Name="TdpControls" Spacing="10" Visibility="Collapsed">
                        <Grid>
                            <TextBlock x:Name="TdpValueText" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource LumenTextBrush}" />
                            <TextBlock x:Name="TdpRangeText" Style="{StaticResource LumenCaptionText}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                        <Slider x:Name="TdpSlider" StepFrequency="1" ValueChanged="OnTdpSliderChanged" AutomationProperties.Name="TDP watts" />
                        <VariableSizedWrapGrid x:Name="TdpPresetPanel" Orientation="Horizontal" ItemWidth="104" ItemHeight="52" />
                        <Button x:Name="TdpRestoreButton" Content="Firmware default" HorizontalAlignment="Stretch" Click="OnTdpRestoreClick" />
                        <TextBlock x:Name="TdpLiveText" Style="{StaticResource LumenCaptionText}" />
                    </StackPanel>
                    <Button x:Name="TdpSetupButton" Content="Set up real TDP control…" HorizontalAlignment="Stretch" Click="OnTdpSetupClick" Visibility="Collapsed" />

                    <TextBlock Text="Frame rate" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource LumenCaptionText}"
                               Text="Lumen does not inject an FPS limiter into games (anti-cheat risk). Use the game's own limiter or Intel Graphics Software. Lowering the refresh rate saves power but is not an FPS limit." />

                <!-- Performance -->
                <StackPanel x:Name="PerfSection" Spacing="8">
                    <TextBlock Text="Performance" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" />
                    <Grid RowSpacing="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="CPU" Style="{StaticResource LumenCaptionText}" />
                        <ProgressBar x:Name="CpuBar" Grid.Column="1" Maximum="100" VerticalAlignment="Center" />
                        <TextBlock x:Name="CpuText" Grid.Column="2" Style="{StaticResource LumenCaptionText}" HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="1" Text="GPU" Style="{StaticResource LumenCaptionText}" />
                        <ProgressBar x:Name="GpuBar" Grid.Row="1" Grid.Column="1" Maximum="100" VerticalAlignment="Center" />
                        <TextBlock x:Name="GpuText" Grid.Row="1" Grid.Column="2" Style="{StaticResource LumenCaptionText}" HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="2" Text="RAM" Style="{StaticResource LumenCaptionText}" />
                        <ProgressBar x:Name="RamBar" Grid.Row="2" Grid.Column="1" Maximum="100" VerticalAlignment="Center" />
                        <TextBlock x:Name="RamText" Grid.Row="2" Grid.Column="2" Style="{StaticResource LumenCaptionText}" HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="3" Text="Temp" Style="{StaticResource LumenCaptionText}" />
                        <TextBlock x:Name="TempText" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource LumenCaptionText}" />
                    </Grid>
                </StackPanel>
                </StackPanel>

                <!-- ================= BATTERY ================= -->
                <StackPanel x:Name="BatteryPanel" Spacing="10" Visibility="Collapsed">
                    <TextBlock x:Name="BatteryBigText" FontSize="40" FontWeight="SemiBold" Foreground="{StaticResource LumenTextBrush}" />
                    <TextBlock x:Name="BatteryStateText" Style="{StaticResource LumenBodyText}" />
                    <TextBlock x:Name="BatteryDetailText" Style="{StaticResource LumenCaptionText}" />
                    <Button Content="Battery saver settings" Tag="ms-settings:batterysaver" Click="OnWindowsSettingsClick" HorizontalAlignment="Stretch" />
                    <Button Content="Power &amp; battery settings" Tag="ms-settings:powersleep" Click="OnWindowsSettingsClick" HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- ================= GAME ================= -->
                <StackPanel x:Name="GamePanel" Spacing="14" Visibility="Collapsed">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="72" Height="108" CornerRadius="8" Background="{StaticResource LumenSurfaceHighBrush}">
                            <Image x:Name="GameArt" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="GameTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource LumenTextBrush}" />
                            <TextBlock x:Name="GameSubtitle" Style="{StaticResource LumenCaptionText}" />
                        </StackPanel>
                    </Grid>

                    <!-- Per-game profile (filled in code; see Feature 3) -->
                    <StackPanel x:Name="ProfilePanel" Spacing="8" />

                    <Button x:Name="CloseGameButton" Content="Close game" HorizontalAlignment="Stretch" Click="OnCloseGameClick" />
                    <Button x:Name="ForceCloseButton" Content="Force close (unsaved progress is lost)" HorizontalAlignment="Stretch"
                            Visibility="Collapsed" Click="OnForceCloseClick" />
                    <TextBlock x:Name="GameStatusText" Style="{StaticResource LumenCaptionText}" />
                </StackPanel>

                <!-- ================= SYSTEM ================= -->
                <StackPanel x:Name="SystemPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Power" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" />
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="128" ItemHeight="56">
                        <Button x:Name="SleepButton" Content="Sleep" Click="OnSleepClick" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                        <Button x:Name="HibernateButton" Content="Hibernate" Click="OnHibernateClick" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                        <Button x:Name="RestartButton" Content="Restart" Click="OnRestartClick" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                        <Button x:Name="ShutdownButton" Content="Shut down" Click="OnShutdownClick" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                        <Button Content="Restart Lumen" Click="OnRestartLumenClick" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                        <Button Content="Task Manager" Click="OnTaskManagerClick" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                    </VariableSizedWrapGrid>
                    <TextBlock x:Name="PowerConfirmText" Style="{StaticResource LumenCaptionText}" />

                    <TextBlock Text="Connections" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="WifiToggle" Header="Wi-Fi" Toggled="OnWifiToggled" Visibility="Collapsed" />
                    <ToggleSwitch x:Name="BluetoothToggle" Header="Bluetooth" Toggled="OnBluetoothToggled" Visibility="Collapsed" />
                    <TextBlock x:Name="RadiosUnavailableText" Style="{StaticResource LumenCaptionText}" Visibility="Collapsed"
                               Text="Wi-Fi/Bluetooth switches are unavailable (no radio found, or radio access is off in Windows privacy settings)." />

                    <TextBlock Text="Lumen" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <ToggleSwitch x:Name="OverlayFullscreenToggle" Header="Fullscreen console mode" Toggled="OnOverlayFullscreenToggled" />
                    <ToggleSwitch x:Name="OverlayMinimizeToggle" Header="Minimize Lumen while playing" Toggled="OnOverlayMinimizeToggled" />
                    <Button Content="All Lumen settings" HorizontalAlignment="Stretch" Click="OnLumenSettingsClick" />

                    <TextBlock Text="Windows settings" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource LumenCaptionText}" Text="Opens on top of Lumen - the desktop stays hidden." />
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="182" ItemHeight="56">
                        <Button Content="Display" Tag="ms-settings:display" Click="OnWindowsSettingsClick" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                        <Button Content="Sound" Tag="ms-settings:sound" Click="OnWindowsSettingsClick" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                        <Button Content="Bluetooth" Tag="ms-settings:bluetooth" Click="OnWindowsSettingsClick" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                        <Button Content="Wi-Fi" Tag="ms-settings:network-wifi" Click="OnWindowsSettingsClick" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                        <Button Content="Battery" Tag="ms-settings:batterysaver" Click="OnWindowsSettingsClick" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                        <Button Content="Updates" Tag="ms-settings:windowsupdate" Click="OnWindowsSettingsClick" HorizontalAlignment="Stretch" Margin="0,0,8,8" />
                    </VariableSizedWrapGrid>
                </StackPanel>

                <Button Content="Close" Click="OnCloseClick" HorizontalAlignment="Stretch" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
