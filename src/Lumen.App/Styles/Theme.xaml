<?xml version="1.0" encoding="utf-8"?>
<!--
  Lumen visual language: deep ink surfaces, a single warm "ember" accent, large type and generous
  hit targets (min 48 epx) for touch, and an unmistakable focus ring for controller use.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent overrides for built-in controls (sliders, toggles) -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFFF8A3D" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6FF8A3D" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCFF8A3D" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF0A0C11" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFFF8A3D" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6FF8A3D" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCFF8A3D" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF0A0C11" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ===== Palette ===== -->
    <Color x:Key="LumenInk">#FF0A0C11</Color>
    <Color x:Key="LumenSurfaceColor">#FF141821</Color>
    <Color x:Key="LumenSurfaceHighColor">#FF1D2230</Color>
    <Color x:Key="LumenStrokeColor">#FF2A3142</Color>
    <Color x:Key="LumenEmber">#FFFF8A3D</Color>
    <Color x:Key="LumenEmberSoftColor">#33FF8A3D</Color>
    <Color x:Key="LumenTextColor">#FFF2F4F8</Color>
    <Color x:Key="LumenTextDimColor">#FF9AA3B2</Color>
    <Color x:Key="LumenGoodColor">#FF5BD49B</Color>
    <Color x:Key="LumenWarnColor">#FFFFC857</Color>
    <Color x:Key="LumenBadColor">#FFFF5D5D</Color>

    <SolidColorBrush x:Key="LumenBackgroundBrush" Color="{StaticResource LumenInk}" />
    <SolidColorBrush x:Key="LumenSurfaceBrush" Color="{StaticResource LumenSurfaceColor}" />
    <SolidColorBrush x:Key="LumenSurfaceHighBrush" Color="{StaticResource LumenSurfaceHighColor}" />
    <SolidColorBrush x:Key="LumenStrokeBrush" Color="{StaticResource LumenStrokeColor}" />
    <SolidColorBrush x:Key="LumenAccentBrush" Color="{StaticResource LumenEmber}" />
    <SolidColorBrush x:Key="LumenAccentSoftBrush" Color="{StaticResource LumenEmberSoftColor}" />
    <SolidColorBrush x:Key="LumenTextBrush" Color="{StaticResource LumenTextColor}" />
    <SolidColorBrush x:Key="LumenTextDimBrush" Color="{StaticResource LumenTextDimColor}" />
    <SolidColorBrush x:Key="LumenGoodBrush" Color="{StaticResource LumenGoodColor}" />
    <SolidColorBrush x:Key="LumenWarnBrush" Color="{StaticResource LumenWarnColor}" />
    <SolidColorBrush x:Key="LumenBadBrush" Color="{StaticResource LumenBadColor}" />

    <!-- Fades the hero artwork into the background -->
    <LinearGradientBrush x:Key="LumenHeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#550A0C11" Offset="0" />
        <GradientStop Color="#CC0A0C11" Offset="0.45" />
        <GradientStop Color="#FF0A0C11" Offset="0.75" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LumenHeroSideScrimBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#EE0A0C11" Offset="0" />
        <GradientStop Color="#000A0C11" Offset="0.7" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LumenTileCaptionBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#000A0C11" Offset="0" />
        <GradientStop Color="#E60A0C11" Offset="1" />
    </LinearGradientBrush>


    <!-- ===== Metrics (effective pixels; tuned for 1920x1200 @150% = 1280x800 epx) ===== -->
    <x:Double x:Key="TileWidth">176</x:Double>
    <x:Double x:Key="TileHeight">264</x:Double>
    <Thickness x:Key="PageMargin">48,0,48,0</Thickness>

    <!-- ===== Typography ===== -->
    <Style x:Key="LumenDisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource LumenTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="LumenSectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource LumenTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="LumenBodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource LumenTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="LumenCaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource LumenTextDimBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===== Controls: big targets + ember focus ring everywhere ===== -->

    <Style TargetType="ToggleSwitch">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource LumenAccentBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="3" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualMargin" Value="-6" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource LumenAccentBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="3" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualMargin" Value="-6" />
    </Style>

    <!-- Game tile: artwork-only button; focus = ember ring + scale (scale applied in code) -->
    <Style x:Key="GameTileButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource LumenSurfaceBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource LumenAccentBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="4" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualMargin" Value="-5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Padding="{TemplateBinding Padding}" />
                        <Border x:Name="HoverOverlay" Background="#14FFFFFF" Opacity="0" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.8" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LumenCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LumenSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LumenStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
    </Style>
</ResourceDictionary>
