<?xml version="1.0" encoding="utf-8"?>
<!--
  Used only when building with -p:LumenPackaging=msix. Replace Publisher with the subject of your
  signing certificate (it must match exactly, e.g. "CN=Your Name").
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="Lumen.HandheldShell" Publisher="CN=Lumen Development" Version="0.1.0.0" />

  <Properties>
    <DisplayName>Lumen</DisplayName>
    <PublisherDisplayName>Lumen</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Lumen"
        Description="Controller-first gaming shell for Windows handhelds"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0A0C11" />
      </uap:VisualElements>
      <Extensions>
        <!-- Off until the user turns it on in Lumen Settings (StartupTask.RequestEnableAsync). -->
        <desktop:Extension Category="windows.startupTask" Executable="Lumen.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="LumenStartup" Enabled="false" DisplayName="Lumen" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
