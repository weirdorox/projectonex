<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lumen.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lumen.App.Controls"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="TileTemplate">
            <controls:GameTile />
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="48,8,48,0" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Filter pills are generated in code (LT / RT cycles them) -->
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Margin="0,0,16,0">
                <StackPanel x:Name="FilterPanel" Orientation="Horizontal" Spacing="10" Padding="4" />
            </ScrollViewer>
            <TextBlock x:Name="CountText" Grid.Column="1" Style="{StaticResource LumenCaptionText}" FontSize="15" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,10,0,32">
            <Grid>
                <ItemsRepeater x:Name="GridRepeater" ItemTemplate="{StaticResource TileTemplate}"
                               ElementPrepared="OnElementPrepared" ElementClearing="OnElementClearing">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="{StaticResource TileWidth}"
                                           MinItemHeight="{StaticResource TileHeight}"
                                           MinRowSpacing="22" MinColumnSpacing="18"
                                           ItemsJustification="Start" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" Style="{StaticResource LumenCaptionText}" FontSize="16"
                           Text="Nothing here yet." Margin="0,24,0,0" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
