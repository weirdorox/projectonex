<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lumen.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lumen.App.Controls"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="TileTemplate">
            <controls:GameTile />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!-- Backdrop: cross-fading hero art + colour wash of the focused game -->
        <controls:HeroStage x:Name="Stage" />

        <ScrollViewer x:Name="Scroller"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="48,8,0,40" Spacing="30">

                <!-- Hero text for the focused game -->
                <StackPanel x:Name="HeroInfo" Spacing="6" Margin="0,24,48,0" MinHeight="120">
                    <Image x:Name="HeroLogo" MaxHeight="104" MaxWidth="440" Stretch="Uniform"
                           HorizontalAlignment="Left" Visibility="Collapsed" />
                    <TextBlock x:Name="HeroTitle" Style="{StaticResource LumenDisplayText}" Text="Welcome" />
                    <TextBlock x:Name="HeroMeta" Style="{StaticResource LumenCaptionText}" FontSize="16" />
                </StackPanel>

                <!-- First-run / setup banner -->
                <Border x:Name="SetupBanner" Style="{StaticResource LumenCardStyle}" Margin="0,0,48,0" Visibility="Collapsed">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Make Lumen your console" Style="{StaticResource LumenSectionHeader}" Margin="0" />
                            <TextBlock Style="{StaticResource LumenCaptionText}"
                                       Text="Start Lumen automatically when you sign in. Every step is optional and reversible - the Windows desktop is always one button away." />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Set up" Style="{StaticResource LumenAccentButtonStyle}" Click="OnSetupClick" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Shelves -->
                <StackPanel x:Name="RecentSection" Visibility="Collapsed">
                    <TextBlock Text="Jump back in" Style="{StaticResource LumenSectionHeader}" />
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Padding="0,10,48,14">
                        <ItemsRepeater x:Name="RecentRepeater" ItemTemplate="{StaticResource TileTemplate}"
                                       ElementPrepared="OnElementPrepared" ElementClearing="OnElementClearing">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="18" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel x:Name="FavoritesSection" Visibility="Collapsed">
                    <TextBlock Text="Favorites" Style="{StaticResource LumenSectionHeader}" />
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Padding="0,10,48,14">
                        <ItemsRepeater x:Name="FavoritesRepeater" ItemTemplate="{StaticResource TileTemplate}"
                                       ElementPrepared="OnElementPrepared" ElementClearing="OnElementClearing">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="18" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel x:Name="PinnedSection" Visibility="Collapsed">
                    <TextBlock x:Name="PinnedHeader" Style="{StaticResource LumenSectionHeader}" />
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Padding="0,10,48,14">
                        <ItemsRepeater x:Name="PinnedRepeater" ItemTemplate="{StaticResource TileTemplate}"
                                       ElementPrepared="OnElementPrepared" ElementClearing="OnElementClearing">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="18" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel x:Name="NewSection" Visibility="Collapsed">
                    <TextBlock Text="Recently added" Style="{StaticResource LumenSectionHeader}" />
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Padding="0,10,48,14">
                        <ItemsRepeater x:Name="NewRepeater" ItemTemplate="{StaticResource TileTemplate}"
                                       ElementPrepared="OnElementPrepared" ElementClearing="OnElementClearing">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="18" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <!-- Empty library -->
                <StackPanel x:Name="EmptyState" Spacing="14" Visibility="Collapsed" Margin="0,0,48,0" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="No games yet" Style="{StaticResource LumenSectionHeader}" />
                    <TextBlock Style="{StaticResource LumenCaptionText}" FontSize="16"
                               Text="Lumen looks for Steam, Epic Games, GOG and Xbox games automatically. You can also add folders with your own games in Settings." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ScanButton" Content="Scan again" Style="{StaticResource LumenAccentButtonStyle}" Click="OnScanClick" />
                        <Button Content="Add a folder" Click="OnSetupClick" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
