<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lumen.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    Background="Transparent">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Padding="48,8,48,48" Spacing="22" MaxWidth="980" HorizontalAlignment="Left">

            <!-- ================= System › Updates ================= -->
            <TextBlock Text="System › Updates" Style="{StaticResource LumenSectionHeader}" FontSize="24" />
            <Border Style="{StaticResource LumenCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="UpdateVersionText" Style="{StaticResource LumenBodyText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Channel" Style="{StaticResource LumenBodyText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button x:Name="ChannelStableButton" Content="Stable" Style="{StaticResource LumenPillButtonStyle}" Click="OnChannelStableClick" />
                        <Button x:Name="ChannelBetaButton" Content="Beta" Style="{StaticResource LumenPillButtonStyle}" Click="OnChannelBetaClick" />
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource LumenBodyText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <ProgressBar x:Name="UpdateProgress" Maximum="1" Visibility="Collapsed" MaxWidth="520" HorizontalAlignment="Left" Width="520" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="UpdateCheckButton" Content="Check for updates" Click="OnUpdateCheckClick" Style="{StaticResource LumenAccentButtonStyle}" />
                        <Button x:Name="UpdateDownloadButton" Content="Download update" Click="OnUpdateDownloadClick" />
                        <Button x:Name="UpdateInstallButton" Content="Install and restart" Click="OnUpdateInstallClick" />
                        <Button x:Name="UpdateNotesButton" Content="View release notes" Click="OnUpdateNotesClick" />
                        <Button x:Name="UpdateRetryButton" Content="Retry" Click="OnUpdateRetryClick" />
                        <Button x:Name="UpdateRollbackButton" Content="Roll back" Click="OnUpdateRollbackClick" />
                    </StackPanel>
                    <TextBlock x:Name="UpdateNotesText" Style="{StaticResource LumenCaptionText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed" />
                    <TextBlock Style="{StaticResource LumenCaptionText}" TextWrapping="Wrap"
                               Text="Updates come from Lumen's GitHub releases and are only installed if they carry Lumen's release signature and match its checksum. Your settings, library, favorites, profiles and themes are kept. Lumen never installs while a game is running, and keeps the previous version's installer so an update can be rolled back." />
                </StackPanel>
            </Border>

            <!-- ================= Display & sound ================= -->
            <TextBlock Text="Display &amp; sound" Style="{StaticResource LumenSectionHeader}" FontSize="24" />
            <Border Style="{StaticResource LumenCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Brightness" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" />
                    <Slider x:Name="SettingsBrightnessSlider" Minimum="5" Maximum="100" StepFrequency="5" MaxWidth="520" HorizontalAlignment="Left" Width="520"
                            ValueChanged="OnSettingsBrightnessChanged" AutomationProperties.Name="Brightness" />
                    <TextBlock x:Name="SettingsBrightnessNote" Style="{StaticResource LumenCaptionText}" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="SettingsHdrToggle" Header="HDR" Toggled="OnSettingsHdrToggled" />
                    <TextBlock x:Name="SettingsHdrNote" Style="{StaticResource LumenCaptionText}" TextWrapping="Wrap" />
                    <Button Content="More: resolution, refresh rate, sound output, microphone, Wi-Fi, power…" Click="OnOpenQuickSettingsClick" />
                    <TextBlock Style="{StaticResource LumenCaptionText}" TextWrapping="Wrap"
                               Text="These live in Quick settings so you can reach them in any game: press ≡ (Menu) in Lumen, View + Menu in a game, or the Quick settings button at the top." />
                </StackPanel>
            </Border>

            <!-- ================= Console mode ================= -->
            <TextBlock Text="Console mode" Style="{StaticResource LumenSectionHeader}" FontSize="24" />
            <Border Style="{StaticResource LumenCardStyle}">
                <StackPanel Spacing="14">
                    <ToggleSwitch x:Name="StartupToggle" Header="Start Lumen when I sign in" Toggled="OnStartupToggled" />
                    <TextBlock x:Name="StartupStatusText" Style="{StaticResource LumenCaptionText}" />
                    <ToggleSwitch x:Name="FullscreenToggle" Header="Fullscreen console mode" Toggled="OnFullscreenToggled" />
                    <ToggleSwitch x:Name="MinimizeToggle" Header="Minimize Lumen while a game is running" Toggled="OnMinimizeToggled" />
                    <ToggleSwitch x:Name="DockFollowToggle" Header="Docked mode: move Lumen to an external display when one is connected" Toggled="OnDockFollowToggled" />
                </StackPanel>
            </Border>

            <!-- ================= Quick settings button ================= -->
            <TextBlock Text="Quick settings button" Style="{StaticResource LumenSectionHeader}" FontSize="24" />
            <Border Style="{StaticResource LumenCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource LumenCaptionText}" TextWrapping="Wrap"
                               Text="Open Quick settings from anywhere - over games, the desktop or Steam - without bringing back the dashboard. Press Detect, then press the OneXPlayer button: Lumen lists exactly what Windows receives (key combination, HID report or controller buttons). If nothing appears, the button is handled by the firmware or OneXConsole and never reaches Windows - map it to a key combination in OneXConsole and detect that instead." />
                    <TextBlock x:Name="ButtonStatusText" Style="{StaticResource LumenBodyText}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ShortcutStatusText" Style="{StaticResource LumenBodyText}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource LumenCaptionText}" Text="Controller: View + Menu always works too." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="DetectButton" Content="Detect a button" Click="OnDetectClick" Style="{StaticResource LumenAccentButtonStyle}" />
                        <Button Content="Remove hardware button" Click="OnRemoveButtonClick" />
                        <Button Content="Reset shortcut to Ctrl+Alt+Q" Click="OnResetShortcutClick" />
                    </StackPanel>
                    <TextBlock x:Name="DetectHint" Style="{StaticResource LumenCaptionText}" TextWrapping="Wrap" Visibility="Collapsed" />
                    <StackPanel x:Name="DetectList" Spacing="6" />
                    <ToggleSwitch x:Name="QsFocusToggle" Header="Compatibility: let Quick settings take focus from the game (some games pause or mute)" Toggled="OnQsFocusToggled" />
                </StackPanel>
            </Border>

            <!-- ================= Steam account ================= -->
            <TextBlock Text="Steam account" Style="{StaticResource LumenSectionHeader}" FontSize="24" />
            <Border Style="{StaticResource LumenCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="SteamStatusText" Style="{StaticResource LumenBodyText}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource LumenCaptionText}" TextWrapping="Wrap"
                               Text="Shows every game you own, including ones that aren't installed (A installs them through Steam). You sign in on Steam's own page - Lumen never sees your password. Loading the game list also needs a free Steam Web API key, which you create once on Steam's site, and your profile's &quot;Game details&quot; must be public. The key is stored encrypted for your Windows account." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="SteamSignInButton" Content="1. Sign in through Steam" Click="OnSteamSignInClick" Style="{StaticResource LumenAccentButtonStyle}" />
                        <Button x:Name="SteamKeyButton" Content="2. Get API key" Click="OnSteamKeyClick" />
                        <Button x:Name="SteamRefreshButton" Content="Refresh library" Click="OnSteamRefreshClick" />
                        <Button x:Name="SteamSignOutButton" Content="Sign out" Click="OnSteamSignOutClick" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox x:Name="SteamKeyBox" PlaceholderText="…or paste the 32-character key here" Width="420" MaxLength="40" />
                        <Button Content="Save key" Click="OnSteamSaveKeyClick" />
                    </StackPanel>
                    <ToggleSwitch x:Name="SteamOwnedToggle" Header="Show games I own but haven't installed (Library › Not installed)" Toggled="OnSteamOwnedToggled" />
                </StackPanel>
            </Border>

            <!-- ================= Personalization ================= -->
            <TextBlock Text="Personalization" Style="{StaticResource LumenSectionHeader}" FontSize="24" />
            <Border Style="{StaticResource LumenCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Accent colour" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" />
                    <StackPanel x:Name="AccentPanel" Orientation="Horizontal" Spacing="8" />
                    <ToggleSwitch x:Name="OledToggle" Header="OLED black (true black backgrounds)" Toggled="OnOledToggled" />
                    <ToggleSwitch x:Name="SoundsToggle" Header="Interface sounds" Toggled="OnSoundsToggled" />
                    <TextBlock Text="Home screen rows" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="HomeRecentToggle" Header="Jump back in" Toggled="OnHomeRowToggled" />
                    <ToggleSwitch x:Name="HomeFavoritesToggle" Header="Favorites" Toggled="OnHomeRowToggled" />
                    <ToggleSwitch x:Name="HomeNewToggle" Header="Recently added" Toggled="OnHomeRowToggled" />
                    <TextBlock Text="Collection on Home" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" />
                    <StackPanel x:Name="PinnedPanel" Orientation="Horizontal" Spacing="8" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource LumenCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Automatic sign-in (optional)" Style="{StaticResource LumenSectionHeader}" Margin="0" />
                    <TextBlock x:Name="AutoSignInStatusText" Style="{StaticResource LumenBodyText}" />
                    <TextBlock Style="{StaticResource LumenCaptionText}"
                               Text="Lumen never stores or changes your password. Automatic sign-in is set up with Microsoft's own tools: Sysinternals Autologon (stores the password encrypted) or the User Accounts dialog. Anyone who picks up the device will be signed in to your account; BitLocker and other protections stay on. You can turn it off again at any time here or with the Lumen Recovery tool." />
                    <TextBlock x:Name="HelloOnlyText" Style="{StaticResource LumenCaptionText}" Foreground="{StaticResource LumenWarnBrush}" Visibility="Collapsed"
                               Text="&quot;For improved security, only allow Windows Hello sign-in&quot; is on. Turn it off in Sign-in options before using User Accounts, otherwise the auto sign-in checkbox is hidden." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Get Sysinternals Autologon" Click="OnAutologonClick" />
                        <Button Content="User Accounts (netplwiz)" Click="OnNetplwizClick" />
                        <Button Content="Sign-in options" Click="OnSignInOptionsClick" />
                    </StackPanel>
                    <Button x:Name="DisableAutoSignInButton" Content="Turn off automatic sign-in…" Click="OnDisableAutoSignInClick" />
                </StackPanel>
            </Border>

            <!-- ================= Performance (real TDP) ================= -->
            <TextBlock Text="Performance" Style="{StaticResource LumenSectionHeader}" FontSize="24" Margin="0,12,0,0" />
            <Border Style="{StaticResource LumenCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Real TDP control (optional)" Style="{StaticResource LumenSectionHeader}" Margin="0" />
                    <TextBlock x:Name="TdpSetupStatusText" Style="{StaticResource LumenBodyText}" />
                    <TextBlock Style="{StaticResource LumenCaptionText}">
                        <Run Text="Changing the processor power limit needs a hardware driver. Lumen uses PawnIO - signed, open source, compatible with Memory Integrity - and never installs it for you:" />
                        <LineBreak /><Run Text="1. Install PawnIO from pawnio.eu." />
                        <LineBreak /><Run Text="2. Put IntelMSR.bin from the official PawnIO.Modules release into the folder opened by the button below." />
                        <LineBreak /><Run Text="3. Enable the Lumen power helper (one administrator prompt). It runs only when Lumen needs it, accepts commands only from your account, and restores the firmware limits when Lumen stops." />
                        <LineBreak /><Run Text="Limits are read from your CPU. A restart always returns to the firmware's own limits." />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Get PawnIO" Click="OnGetPawnIoClick" />
                        <Button Content="Open module folder" Click="OnModuleFolderClick" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="TdpEnableButton" Content="Enable power helper" Style="{StaticResource LumenAccentButtonStyle}" Click="OnTdpEnableClick" />
                        <Button x:Name="TdpDisableButton" Content="Remove power helper" Click="OnTdpDisableClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= Library ================= -->
            <TextBlock Text="Library" Style="{StaticResource LumenSectionHeader}" FontSize="24" Margin="0,12,0,0" />
            <Border Style="{StaticResource LumenCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Game folders" Style="{StaticResource LumenBodyText}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource LumenCaptionText}"
                               Text="Each sub-folder is treated as one game. Drop a cover.jpg into a game's folder to give it artwork." />
                    <StackPanel x:Name="FoldersPanel" Spacing="8" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Add folder…" Click="OnAddFolderClick" />
                        <Button x:Name="ScanButton" Content="Scan now" Style="{StaticResource LumenAccentButtonStyle}" Click="OnScanClick" />
                    </StackPanel>
                    <TextBlock x:Name="ScanResultText" Style="{StaticResource LumenCaptionText}" />
                    <ToggleSwitch x:Name="OnlineArtToggle" Header="Download missing Steam artwork from Steam's servers" Toggled="OnOnlineArtToggled" />
                    <ToggleSwitch x:Name="GalaxyToggle" Header="Launch GOG games through GOG Galaxy (cloud saves)" Toggled="OnGalaxyToggled" />
                    <TextBlock Style="{StaticResource LumenCaptionText}" Text="Library source changes apply after Lumen restarts." />
                </StackPanel>
            </Border>

            <!-- ================= Device ================= -->
            <TextBlock Text="Device" Style="{StaticResource LumenSectionHeader}" FontSize="24" Margin="0,12,0,0" />
            <Border Style="{StaticResource LumenCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="DeviceText" Style="{StaticResource LumenBodyText}" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="ProfileText" Style="{StaticResource LumenCaptionText}" />
                    <StackPanel x:Name="FeaturesPanel" Spacing="6" />
                </StackPanel>
            </Border>

            <!-- ================= Troubleshooting ================= -->
            <TextBlock Text="Troubleshooting" Style="{StaticResource LumenSectionHeader}" FontSize="24" Margin="0,12,0,0" />
            <Border Style="{StaticResource LumenCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource LumenCaptionText}" FontSize="15">
                        <Run Text="Ways back to the Windows desktop, always available:" />
                        <LineBreak /><Run Text="• The Desktop button in the top bar" />
                        <LineBreak /><Run Text="• Quick access (View + Menu) → Windows desktop" />
                        <LineBreak /><Run Text="• Hold View + Menu + LB + RB for 3 seconds" />
                        <LineBreak /><Run Text="• Ctrl + Alt + Home brings Lumen back; Ctrl + Alt + Del and Alt + Tab always work" />
                        <LineBreak /><Run Text="• Start menu → Lumen Recovery" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Open log folder" Click="OnLogsClick" />
                        <Button x:Name="RestoreButton" Content="Restore normal Windows startup" Click="OnRestoreClick" />
                        <Button Content="Exit Lumen" Click="OnExitClick" />
                    </StackPanel>
                    <TextBlock x:Name="TroubleshootText" Style="{StaticResource LumenCaptionText}" />
                </StackPanel>
            </Border>

            <!-- ================= Diagnostics ================= -->
            <TextBlock Text="Diagnostics" Style="{StaticResource LumenSectionHeader}" FontSize="24" />
            <Border Style="{StaticResource LumenCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource LumenCaptionText}" TextWrapping="Wrap"
                               Text="What Lumen detected on this device: which features are available, unavailable (and why) or locked by the firmware, with live TDP readback and measured power. Export creates a zip of the logs and this report in Documents - nothing is uploaded." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="DiagnosticsButton" Content="Run diagnostics" Click="OnDiagnosticsClick" />
                        <Button Content="Export logs (zip)" Click="OnExportLogsClick" />
                    </StackPanel>
                    <TextBlock x:Name="DiagnosticsText" FontFamily="Consolas" FontSize="13" IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" Foreground="{StaticResource LumenTextDimBrush}" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="AboutText" Style="{StaticResource LumenCaptionText}" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
