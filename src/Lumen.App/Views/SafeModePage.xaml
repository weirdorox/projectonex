<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lumen.App.Views.SafeModePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="48,24,48,48" Spacing="20" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Lumen started in safe mode" Style="{StaticResource LumenDisplayText}" FontSize="34" TextWrapping="Wrap" />
            <TextBlock x:Name="ReasonText" Style="{StaticResource LumenBodyText}" />
            <TextBlock Style="{StaticResource LumenCaptionText}" FontSize="16"
                       Text="Lumen is running in a window and is not scanning for games. Nothing about Windows has been changed. Choose what to do:" />

            <StackPanel Spacing="12">
                <Button x:Name="DesktopButton" Style="{StaticResource LumenAccentButtonStyle}" Click="OnDesktopClick" HorizontalAlignment="Stretch">
                    <TextBlock Text="Go to the Windows desktop" />
                </Button>
                <Button x:Name="DisableButton" Click="OnDisableClick" HorizontalAlignment="Stretch">
                    <TextBlock Text="Stop Lumen from starting automatically" />
                </Button>
                <Button Click="OnLogsClick" HorizontalAlignment="Stretch">
                    <TextBlock Text="Open the log folder" />
                </Button>
                <Button Click="OnContinueClick" HorizontalAlignment="Stretch">
                    <TextBlock Text="Continue to Lumen (windowed)" />
                </Button>
            </StackPanel>
            <TextBlock x:Name="ResultText" Style="{StaticResource LumenCaptionText}" FontSize="16" />
        </StackPanel>
    </ScrollViewer>
</Page>
