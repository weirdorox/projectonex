<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lumen.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lumen.App.Controls"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="TileTemplate">
            <controls:GameTile />
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="48,8,48,0" ColumnSpacing="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="KeyboardColumn" Spacing="16" VerticalAlignment="Top">
            <TextBox x:Name="QueryBox" PlaceholderText="Search your games" FontSize="22" MaxLength="40"
                     IsTabStop="False" TextChanged="OnQueryChanged"
                     AutomationProperties.Name="Search query" />
            <controls:OnScreenKeyboard x:Name="Keyboard" />
            <TextBlock Style="{StaticResource LumenCaptionText}" TextWrapping="Wrap" MaxWidth="560"
                       Text="X delete · Y space · RT results · LT keyboard. A physical keyboard works too." />
        </StackPanel>

        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="CountText" Style="{StaticResource LumenCaptionText}" FontSize="15" />
            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollMode="Disabled" Padding="0,6,0,32">
                <Grid>
                    <ItemsRepeater x:Name="ResultsRepeater" ItemTemplate="{StaticResource TileTemplate}"
                                   ElementPrepared="OnElementPrepared" ElementClearing="OnElementClearing">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="{StaticResource TileWidth}"
                                               MinItemHeight="{StaticResource TileHeight}"
                                               MinRowSpacing="22" MinColumnSpacing="18" ItemsJustification="Start" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <TextBlock x:Name="EmptyText" Visibility="Collapsed" Style="{StaticResource LumenCaptionText}" FontSize="16" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
