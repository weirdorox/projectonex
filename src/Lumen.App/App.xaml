<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Lumen.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              Styles based on WinUI's built-in styles live here (not in Theme.xaml) so the
              StaticResource BasedOn lookups resolve against the merged XamlControlsResources.
            -->
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="MinWidth" Value="48" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource LumenAccentBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="3" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="FocusVisualMargin" Value="-4" />
            </Style>

            <Style x:Key="LumenAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="22,10" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource LumenTextBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="3" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="FocusVisualMargin" Value="-4" />
            </Style>

            <Style x:Key="LumenTabButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource LumenTextDimBrush}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="18,6" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource LumenAccentBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="3" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="FocusVisualMargin" Value="-3" />
            </Style>

            <Style x:Key="LumenPillButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{StaticResource LumenSurfaceBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource LumenTextDimBrush}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="16,6" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource LumenAccentBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="3" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="FocusVisualMargin" Value="-3" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
