<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Stand-alone console tool that returns the device to normal Windows operation. Deliberately has
    no UI framework dependency so it keeps working if the shell itself is broken.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Lumen.Recovery</RootNamespace>
    <AssemblyName>Lumen.Recovery</AssemblyName>
    <ApplicationIcon>..\Lumen.App\Assets\Lumen.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lumen.Core\Lumen.Core.csproj" />
    <ProjectReference Include="..\Lumen.Platform.Windows\Lumen.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
