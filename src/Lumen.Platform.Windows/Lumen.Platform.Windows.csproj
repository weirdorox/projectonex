<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows integrations behind the Core contracts: XInput, registry, process launch, Xbox/MSIX
    package discovery, power notifications, documented hardware APIs (Core Audio, WMI brightness,
    display modes, power plans, performance counters), startup registration and auto sign-in status.
    No UI types here, so it can be reused by the recovery tool and tested without WinUI.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Lumen.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lumen.Core\Lumen.Core.csproj" />
  </ItemGroup>
</Project>
